{
  "name": "@workspace/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src -e ts,js --exec \"node ./build.mjs && node --env-file=.env --enable-source-maps ./dist/index.mjs\"",
    "build": "node ./build.mjs",
    "start": "node --env-file=.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  }
}
